{
  "crons": [
    {
      "path": "/api/cron/sync-calendars",
      "schedule": "0 6,12,18 * * *"
    },
    {
      "path": "/api/cron/refresh-content",
      "schedule": "*/15 5-23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/kiosk",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self)"
        }
      ]
    }
  ]
}
